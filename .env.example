TRANSFER_MODE=sandbox

# Server-only provider credentials. Never expose these as VITE_* variables.
KYC_PROVIDER=sandbox-kyc
KYC_PROVIDER_API_KEY=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_ENVIRONMENT=sandbox
PERSONA_WEBHOOK_SECRET=
SANCTIONS_PROVIDER=sandbox-screening
SANCTIONS_PROVIDER_API_KEY=
SANCTIONS_WEBHOOK_SECRET=
RISK_PROVIDER=sandbox-risk-rules
RISK_PROVIDER_API_KEY=
FUNDING_PROVIDER=sandbox-funding
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLAID_SECRET=
EXCHANGE_PROVIDER=sandbox-fx
EXCHANGE_PROVIDER_API_KEY=
SETTLEMENT_PROVIDER=sandbox-xrpl-compatible
XRPL_WALLET_ADDRESS=
XRPL_WALLET_SECRET=
PAYOUT_PROVIDER=sandbox-payout
PAYOUT_PROVIDER_API_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication (Supabase Auth) ---------------------------------------
# Browser-side. The ANON key is safe to ship to the client; the service role
# key above is not and must never be given a VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phone sign-in needs an SMS provider (Twilio or similar) configured inside
# Supabase and costs money per message. The option stays hidden until this is
# set to true, so nothing fails in front of a sender.
VITE_ENABLE_PHONE_AUTH=false

# --- Pre-transfer controls -------------------------------------------------
# Sanctions screening fails closed. There is no screening provider wired up
# yet, so every transfer is blocked unless this is set to true. That is
# deliberate: set it only for pre-launch testing, and never with real money.
NEXA_ALLOW_UNSCREENED=false
